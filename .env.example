# 真实模型效果验证的凭据
#
# 用法：
#   set -a && source .env && set +a
#   node dev/mock-server.mjs &
#   node dev/static-server.mjs 8000 &
#   LIVE_ROUNDS=20 node dev/verify-live.mjs
#
# 或者更简单，直接在终端里一次性设：
#   DEEPSEEK_API_KEY=sk-xxx node dev/verify-live.mjs
#
# 注意：这个文件已被 .gitignore 排除，不会入库。

# ── DeepSeek（推荐，最便宜）─────────────────────────────────────────
# 获取：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ── 其它服务商（想换的时候填其中一组，把 LIVE_PROVIDER 也改掉）──
# OPENAI_API_KEY=
# ZHIPU_API_KEY=
# MOONSHOT_API_KEY=

# 默认服务商：deepseek | openai | zhipu | moonshot
LIVE_PROVIDER=deepseek

# 默认模型（想换模型时改这里）
# deepseek-chat | deepseek-reasoner
LIVE_MODEL=deepseek-chat
